[resource]
script = ExtResource("1_cr")
id = &"linear_search"
display_name = "Linear Searcher"
difficulty = 2
prompt = "Implementa `int linearSearch(vector<int> arr, int target)` que retorne el índice de target en arr, o -1 si no está."
starter_code = "int linearSearch(vector<int> arr, int target) {\n    // tu código aquí\n    return -1;\n}"
function_signature = "int linearSearch(vector<int> arr, int target)"
function_name_hint = "linearSearch"
test_cases = Array[Resource]([SubResource("TestCase_1"), SubResource("TestCase_2"), SubResource("TestCase_3"), SubResource("TestCase_4"), SubResource("TestCase_5")])
time_limit_ms = 30000
base_damage = 20
perfect_damage = 80
tags = PackedStringArray("search", "array", "loop", "beginner")
runner_path = "res://data/challenges/linear_search_runner.gd"
ast_min_statements = 3
ast_required_features = PackedStringArray("loop", "return")
ast_return_substring = "int"
validation_mode = "ast_oracle"
