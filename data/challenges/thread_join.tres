[resource]
script = ExtResource("1_cr")
id = &"thread_join"
display_name = "El Wyrm de los Hilos"
difficulty = 6
prompt = "Implementa `int sumInThreads(int n)` que devuelva la suma de 1 a n repartiendo el trabajo entre varios hilos con `std::thread` y esperándolos con `join()` antes de devolver."
starter_code = "#include <thread>\n\nint sumInThreads(int n) {\n    // tu código aquí\n    return 0;\n}"
function_signature = "int sumInThreads(int n)"
function_name_hint = "sumInThreads"
test_cases = Array[Resource]([SubResource("TestCase_1"), SubResource("TestCase_2"), SubResource("TestCase_3"), SubResource("TestCase_4")])
time_limit_ms = 30000
base_damage = 40
perfect_damage = 145
tags = PackedStringArray("concurrency", "thread", "advanced")
runner_path = "res://data/challenges/thread_join_runner.gd"
ast_min_statements = 4
ast_required_features = PackedStringArray("loop", "call", "return")
ast_return_substring = "int"
validation_mode = "ast_oracle"
