[resource]
script = ExtResource("1_cr")
id = &"bubble_sort"
display_name = "Bubble Sort Goblin"
difficulty = 2
prompt = "Implementa `bubbleSort(vector<int> arr)` que retorne el vector ordenado ascendentemente."
starter_code = "vector<int> bubbleSort(vector<int> arr) {\n    // tu código aquí\n    return arr;\n}"
function_signature = "vector<int> bubbleSort(vector<int> arr)"
function_name_hint = "bubbleSort"
test_cases = Array[Resource]([SubResource("TestCase_1"), SubResource("TestCase_2"), SubResource("TestCase_3"), SubResource("TestCase_4"), SubResource("TestCase_5"), SubResource("TestCase_6")])
time_limit_ms = 30000
base_damage = 20
perfect_damage = 80
tags = PackedStringArray("sorting", "array", "beginner")
runner_path = "res://data/challenges/bubble_sort_runner.gd"
