[resource]
script = ExtResource("1_cr")
id = &"simple_dp"
display_name = "Stair Climber"
difficulty = 4
prompt = "Implementa `int climbStairs(int n)` que retorne de cuántas formas puedes subir n escalones si solo puedes avanzar 1 o 2 escalones a la vez. Usa DP tabulativa (no recursión)."
starter_code = "int climbStairs(int n) {\n    // tu código aquí\n    return 0;\n}"
function_signature = "int climbStairs(int n)"
function_name_hint = "climbStairs"
test_cases = Array[Resource]([SubResource("TestCase_1"), SubResource("TestCase_2"), SubResource("TestCase_3"), SubResource("TestCase_4"), SubResource("TestCase_5"), SubResource("TestCase_6")])
time_limit_ms = 30000
base_damage = 35
perfect_damage = 130
tags = PackedStringArray("dp", "intermediate", "fibonacci")
runner_path = "res://data/challenges/simple_dp_runner.gd"
ast_min_statements = 5
ast_required_features = PackedStringArray("loop", "return", "if")
ast_return_substring = "int"
validation_mode = "ast_oracle"
