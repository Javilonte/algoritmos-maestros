[resource]
script = ExtResource("1_cr")
id = &"final_gate"
display_name = "El Examen Final"
difficulty = 7
prompt = "El examen final: implementa `int sumOfDistinctSorted(vector<int> arr)` que ordene el vector y devuelva la suma de los valores DISTINTOS (cada repetido cuenta una sola vez). Usá un `unordered_map` para llevar los que ya viste."
starter_code = "#include <algorithm>\n#include <unordered_map>\n\nint sumOfDistinctSorted(vector<int> arr) {\n    // tu código aquí\n    return 0;\n}"
function_signature = "int sumOfDistinctSorted(vector<int> arr)"
function_name_hint = "sumOfDistinctSorted"
test_cases = Array[Resource]([SubResource("TestCase_1"), SubResource("TestCase_2"), SubResource("TestCase_3"), SubResource("TestCase_4"), SubResource("TestCase_5"), SubResource("TestCase_6"), SubResource("TestCase_7"), SubResource("TestCase_8")])
time_limit_ms = 30000
base_damage = 45
perfect_damage = 160
tags = PackedStringArray("stl", "map", "sorting", "boss")
skill_id = &"final_boss"
runner_path = "res://data/challenges/final_gate_runner.gd"
ast_min_statements = 6
ast_required_features = PackedStringArray("loop", "conditional", "call", "return")
ast_return_substring = "int"
validation_mode = "ast_oracle"
