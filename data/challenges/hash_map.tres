[resource]
script = ExtResource("1_cr")
id = &"hash_map"
display_name = "Hash Counter"
difficulty = 3
prompt = "Implementa `int countUnique(vector<int> arr)` que retorne cuántos valores distintos hay en arr. Usa unordered_map o equivalente para O(n)."
starter_code = "int countUnique(vector<int> arr) {\n    // tu código aquí\n    return 0;\n}"
function_signature = "int countUnique(vector<int> arr)"
function_name_hint = "countUnique"
test_cases = Array[Resource]([SubResource("TestCase_1"), SubResource("TestCase_2"), SubResource("TestCase_3"), SubResource("TestCase_4"), SubResource("TestCase_5"), SubResource("TestCase_6")])
time_limit_ms = 30000
base_damage = 30
perfect_damage = 110
tags = PackedStringArray("hash", "loop", "intermediate")
runner_path = "res://data/challenges/hash_map_runner.gd"
ast_min_statements = 3
ast_required_features = PackedStringArray("loop", "return")
ast_return_substring = "int"
validation_mode = "ast_oracle"
