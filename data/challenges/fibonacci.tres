[resource]
script = ExtResource("1_cr")
id = &"fibonacci"
display_name = "Fibonacci Lich"
difficulty = 4
prompt = "Implementa `int fibonacci(int n)` que retorne el n-ésimo número de Fibonacci (F(0)=0, F(1)=1)."
starter_code = "int fibonacci(int n) {\n    // tu código aquí\n    return 0;\n}"
