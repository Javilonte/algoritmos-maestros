[resource]
script = ExtResource("1_cr")
id = &"binary_search"
display_name = "Binary Searcher"
difficulty = 3
prompt = "Implementa `int binarySearch(vector<int> arr, int target)` (arr está ordenado ascendente) que retorne el índice de target o -1."
starter_code = "int binarySearch(vector<int> arr, int target) {\n    // tu código aquí\n    return -1;\n}"
function_signature = "int binarySearch(vector<int> arr, int target)"
function_name_hint = "binarySearch"
test_cases = Array[Resource]([SubResource("TestCase_1"), SubResource("TestCase_2"), SubResource("TestCase_3"), SubResource("TestCase_4"), SubResource("TestCase_5"), SubResource("TestCase_6")])
time_limit_ms = 30000
base_damage = 25
perfect_damage = 100
tags = PackedStringArray("search", "array", "loop", "intermediate")
runner_path = "res://data/challenges/binary_search_runner.gd"
ast_min_statements = 4
ast_required_features = PackedStringArray("loop", "return", "if")
ast_return_substring = "int"
validation_mode = "ast_oracle"
