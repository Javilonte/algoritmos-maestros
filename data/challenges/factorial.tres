[resource]
script = ExtResource("1_cr")
id = &"factorial"
display_name = "Factorial Wraith"
difficulty = 3
prompt = "Implementa `int factorial(int n)` que retorne n! (n! = n × (n-1) × ... × 1, y 0! = 1)."
starter_code = "int factorial(int n) {\n    // tu código aquí\n    return 0;\n}"
function_signature = "int factorial(int n)"
function_name_hint = "factorial"
test_cases = Array[Resource]([SubResource("TestCase_1"), SubResource("TestCase_2"), SubResource("TestCase_3"), SubResource("TestCase_4")])
time_limit_ms = 30000
base_damage = 25
perfect_damage = 90
tags = PackedStringArray("recursion", "math", "intermediate")
runner_path = "res://data/challenges/factorial_runner.gd"
ast_min_statements = 2
ast_required_features = PackedStringArray("return")
ast_return_substring = "int"
validation_mode = "ast_oracle"
