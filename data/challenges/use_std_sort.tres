[gd_resource type="Resource" script_class="ChallengeResource" load_steps=8 format=3]

[ext_resource type="Script" path="res://resources/challenge_resource.gd" id="1_cr"]
[ext_resource type="Script" path="res://resources/test_case.gd" id="2_tc"]

[sub_resource type="Resource" id="TestCase_1"]
script = ExtResource("2_tc")
name = "empty_array"
inputs = [[]]
