expected = [-10, -3, -1, 0, 2, 5, 7]
weight = 1.0

[resource]
script = ExtResource("1_cr")
id = &"use_std_sort"
display_name = "El Archivista Real"
difficulty = 3
prompt = "Implementa `vector<int> sortWithStd(vector<int> arr)` que retorne el vector ordenado ascendentemente usando `std::sort` de la biblioteca estándar."
starter_code = "vector<int> sortWithStd(vector<int> arr) {\n    // tu código aquí\n    return arr;\n}"
function_signature = "vector<int> sortWithStd(vector<int> arr)"
function_name_hint = "sortWithStd"
test_cases = Array[Resource]([SubResource("TestCase_1"), SubResource("TestCase_2"), SubResource("TestCase_3"), SubResource("TestCase_4"), SubResource("TestCase_5")])
time_limit_ms = 30000
base_damage = 25
perfect_damage = 100
tags = PackedStringArray("stl", "sorting", "intermediate")
skill_id = &"stl_containers"
runner_path = "res://data/challenges/use_std_sort_runner.gd"
ast_min_statements = 2
ast_required_features = PackedStringArray("call", "return")
ast_return_substring = "vector"
validation_mode = "ast_oracle"
