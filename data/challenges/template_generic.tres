[resource]
script = ExtResource("1_cr")
id = &"template_generic"
display_name = "El Genio del Molde"
difficulty = 5
prompt = "Implementa `int maxOf(vector<int> arr)` que retorne el valor más grande del vector. La función tiene que ser GENÉRICA: escribila como `template<typename T>` para que sirva con cualquier tipo comparable."
starter_code = "template <typename T>\nint maxOf(vector<T> arr) {\n    // tu código aquí\n    return 0;\n}"
function_signature = "int maxOf(vector<int> arr)"
function_name_hint = "maxOf"
test_cases = Array[Resource]([SubResource("TestCase_1"), SubResource("TestCase_2"), SubResource("TestCase_3"), SubResource("TestCase_4"), SubResource("TestCase_5")])
time_limit_ms = 30000
base_damage = 35
perfect_damage = 130
tags = PackedStringArray("template", "generics", "advanced")
skill_id = &"templates"
runner_path = "res://data/challenges/template_generic_runner.gd"
ast_min_statements = 4
ast_required_features = PackedStringArray("template", "loop", "conditional", "return")
ast_return_substring = "int"
validation_mode = "ast_oracle"
