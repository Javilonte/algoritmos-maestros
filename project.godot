; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Algoritmos Maestros"
run/main_scene="uid://splash0screen0uid"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
CodeValidator="*res://scripts/autoload/code_validator.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
ChallengeRegistry="*res://scripts/autoload/challenge_registry.gd"
CodeCompiler="*res://scripts/autoload/code_compiler.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
SkillTree="*res://scripts/gameplay/skill_tree.gd"
IsoAtlasBuilder="*res://scripts/iso/iso_atlas_builder.gd"

[debug]

gdscript/warnings/unused_signal=0

[gui]

theme/custom="res://assets/themes/d2_theme.tres"

